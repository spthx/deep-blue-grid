{
  "name": "deep-blue-grid",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "start": "vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/game-rules.test.ts tests/mission-records.test.ts tests/mission-simulation.test.ts tests/training-rules.test.ts tests/training-progress.test.ts tests/unity-handoff.test.ts tests/rendered-html.test.mjs",
    "export:unity": "node --experimental-strip-types scripts/export-unity-content.ts",
    "measure:missions": "node --experimental-strip-types scripts/measure-missions.ts",
    "measure:survival": "node --experimental-strip-types scripts/measure-survival.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern gh-pages-dist",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module"
}
